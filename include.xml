<?xml version="1.0" encoding="UTF-8"?>
<extension
	xmlns="http://lime.openfl.org/project/1.0.4"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

	<section if="android">
		<java path="project/src/main/java" />
		<dependency name="androidx.core:core:1.9.0" />

		<config:android extension="androidmanager.CallbackManager" />

		<section if="PLAY_GAMES_APP_ID">
			<dependency name="android-manager-playgames" path="dependencies/playgames" />
			<config:android extension="androidmanager.PlayGamesManager" />
			<config:android permission="android.permission.INTERNET" />
		</section>

		<section unless="ANDROID_MANAGER_NO_PERMISSIONS">
			<config:android permission="android.permission.ACCESS_NETWORK_STATE" />
			<config:android permission="android.permission.VIBRATE" />
			<config:android permission="android.permission.DETECT_SCREEN_CAPTURE" />
		</section>
	</section>
</extension>
